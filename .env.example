# =============================================================================
# .env.example — Copia a .env y completa los valores
#   Windows (PowerShell):  copy .env.example .env
#   bash:                  cp .env.example .env
# ⚠️ ESTE ARCHIVO ES SOLO PLANTILLA: nunca pongas valores reales aquí.
#    Las credenciales reales van EXCLUSIVAMENTE en .env (que git ignora).
# =============================================================================

# --- Flask / sesión ----------------------------------------------------------
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# 0 = desarrollo (HTTP local) · 1 = producción (HTTPS obligatorio)
SESSION_COOKIE_SECURE=0
# 1 solo si la app corre detrás de Nginx/Railway/Render (IP y https reales)
TRUST_PROXY_HEADERS=0
# production → valida credenciales y usa cookies seguras (fail-fast)
FLASK_ENV=development

# --- Supabase (BD Postgres + Storage de comprobantes) -------------------------
# Dashboard → Settings → API Keys:
#   Project URL     → SUPABASE_URL
#   Publishable key → SUPABASE_PUBLISHABLE_KEY (pública; solo frontend)
#   Secret key      → SUPABASE_SECRET_KEY (sb_secret_..., SECRETO: solo backend)
#   (formato legacy aceptado: SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cadena de la base de datos: Dashboard → Connect → Session pooler (puerto 5432).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la BD del proyecto.
DATABASE_URL=postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Bucket privado para comprobantes (la app lo crea sola al primer upload)
SUPABASE_BUCKET_PROOFS=payment-proofs

# --- Rate limiting ------------------------------------------------------------
# Con >1 worker de gunicorn usar Redis para que los límites sean globales:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# --- Admin seed (solo crea el usuario si no existe) ---------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@beauty-nicaragua.com
# En producción: contraseña FUERTE (fail-fast si queda por defecto).
ADMIN_PASSWORD=

# --- Observabilidad (opcional) -------------------------------------------------
# Errores a Sentry (dashboard gratuito). Vacío = sin Sentry.
# LOG_FORMAT=json  → logs en JSON por línea (Railway / ingesta de logs)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_FORMAT=

# --- WhatsApp -----------------------------------------------------------------
WHATSAPP_NUMBER=50576721749
WHATSAPP_DEFAULT_MSG=Hola Beauty Nicaragua, quiero consultar una cita.

# Anticipo por transferencia
DEPOSIT_PERCENT=30
BANK_NAME=BAC Credomatic
BANK_ACCOUNT=XXXX-XXXX-XXXX-1234
BANK_HOLDER=Beauty Nicaragua S.A.

# --- Email (SMTP) --------------------------------------------------------------
# Sin credenciales, los emails se registran en logs (modo dev).
MAIL_ENABLED=0
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Beauty Nicaragua <info@beauty-nicaragua.com>
ADMIN_NOTIFY_EMAIL=admin@beauty-nicaragua.com

# --- Twilio WhatsApp (opcional) -------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
